<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS Password AutoFill inside the WebView: the app declares the host, the host serves
	     /.well-known/apple-app-site-association naming this app (src/app/.well-known/...). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.contractornorth.com</string>
	</array>
	<!-- APNs. `development` is what belongs in the source file: Xcode REPLACES it with
	     `production` when it exports an archive for TestFlight / the App Store, so one file
	     serves both. The server copes with either — it sends to the production APNs host and
	     retries the sandbox host once on BadDeviceToken, then remembers which one answered
	     (src/lib/apns.ts), because a device token is only valid in the environment that
	     issued it and a debug build and a TestFlight build issue different ones. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
