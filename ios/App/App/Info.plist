<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- ProMotion. Without this key iOS caps an app's frame rate at 60 Hz on 120 Hz iPhones
	     (Erik's 16 Pro) — Safari scrolls at 120, a WKWebView inside a third-party app does not
	     unless the app opts in. Scroll, momentum and the glass dock's motion get the full rate. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>North</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>North can use Bluetooth to talk to a supported card reader. Tap to Pay on iPhone itself needs no reader — the phone is the reader.</string>
	<key>NSCameraUsageDescription</key>
	<string>North uses the camera so you can photograph job sites, materials, receipts and documents and attach them to the job.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>North uses your location to stamp where you clocked in, verify you're at the job site, get local weather for scheduling, and to take Tap to Pay on iPhone payments — Apple requires a location fix to accept a card.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>North uses the microphone when you talk to Nort, the in-app assistant, or dictate notes. The recording is sent to a speech service to turn it into text.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>North can save documents and photos it generates back to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>North lets you attach photos from your library to jobs, inspections and receipts.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<!-- THE iPHONE MAY NOW BE TURNED SIDEWAYS — but only where a screen says so.
	     This list is the OUTER BOUND, not the policy: it is what iOS will even consider, and it
	     cannot be read per screen because it is compiled into the app. The policy lives one layer
	     in, at NorthBridgeViewController.supportedInterfaceOrientations, which answers portrait on
	     every screen until the page asks for sideways through the ScreenTurn plugin. WHICH screens
	     ask is one declared list in the web app, src/lib/screens-that-turn.ts, where every entry
	     carries the reason it warrants the width. Upside down is deliberately absent.
	     Changing this file is why the shell has to be rebuilt and reinstalled for any of it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
