# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never commit secrets.
# `.env*.local` matched NOTHING that `vercel env pull --environment=production` or Next's own
# convention writes: .env.production, .env.development, .env.test, .env.vercel were all
# committable (audit v921). Ignore every .env* and un-ignore the one that is meant to be read.
.env*
!.env.example

# iOS signing + service credentials. The repo carries ios/ + ci_scripts/ now, and it is PUBLIC:
# an App Store Connect key (AuthKey_*.p8) or a .p12 is a signing identity, not a config file
# (audit v921). Info.plist is deliberately NOT matched — only the credential-bearing names are.
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
**/GoogleService-Info.plist
**/ExportOptions.plist

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor / OS
.idea
.vscode/*
!.vscode/extensions.json

# supabase local
/supabase/.branches
/supabase/.temp

# claude code local settings
.claude/settings.local.json
.claude/

# remote-control automation state + logs (local only)
/automation/
/Contractor_North_Subscriptions.xlsx
/Tahoe_Deck_SEO_Source_of_Truth.pdf
/ET_Electric_SEO_Source_of_Truth.pdf

# Throwaway DB-inspection scripts written by audit subagents at the repo root.
# These embed a connection string; one was swept into a commit by `git add -A`
# (2026-07-25). Never let that happen again — the repo is PUBLIC.
/.tmp-*.mjs
/.tmp-*.cjs
/.audit-*.js
/.tokenlens-*.js
/q_audit_tmp.cjs
/*_tmp.cjs

# ── THROWAWAY SCRIPTS: ALLOWLIST THE REPO ROOT, DO NOT DENYLIST NAMES ─────────
# The rules above were a denylist of filename patterns (/.tmp-*.mjs, /.audit-*.js…).
# A denylist of names cannot hold: `.iso2.mjs` was sitting in this repo root and
# `git check-ignore` confirmed it was NOT ignored, so `git add -A` would have committed it.
# These scripts build a Postgres connection string from CN_PW at runtime — committing one
# to a public repo is a credential leak with a filename typo as its only cause.
#
# So: ignore EVERY loose script at the repo root, then un-ignore the handful that belong.
# A new throwaway is safe by default; a real one has to be named on purpose.
/*.mjs
/*.cjs
/*.js
!/next.config.js
!/next.config.mjs
!/postcss.config.js
!/postcss.config.mjs
!/tailwind.config.js
!/eslint.config.js
!/eslint.config.mjs

# …and the same throwaway names ONE DIRECTORY DOWN. The allowlist above is root-anchored
# (`/*.mjs`), so `scripts/.tmp-probe.mjs` — an audit agent's CN_PW-building probe written
# beside the real scripts — was committable by `git add -A` exactly as the 2026-07-25 leak was
# (audit v921). Real scripts (scripts/db-query.mjs, run-migrations.mjs) don't carry these names.
**/.tmp-*
**/.audit-*
**/.tokenlens-*
**/*_tmp.*
**/probe*.js
**/probe*.cjs
**/probe*.mjs
