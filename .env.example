# ─────────────────────────────────────────────────────────────────────────────
# Contractor North — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# EVERY NAME THE CODE READS IS HERE (cn-v1139; tests/env-example-complete.test.ts refuses a name
# read in src/, scripts/, next.config.ts or capacitor.config.ts that is not listed, a listed name
# nothing reads, and any value shaped like a key). Names and placeholders only — never a value.
# Grouped by who issues the value; one line of why above each.

# ── Supabase — Project Settings → API ────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co (the browser and the server both read it).
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key (safe for the browser — protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret key (server-only — bypasses RLS; NEVER expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# ── The held seal — the timeclock take-back's own key (lib/held-seal) — OPTIONAL ──────────
# Any long random string; rotate by moving the old value to _PREVIOUS for a week (blank: the seal is keyed with the service key, as before).
HELD_SEAL_SECRET=
# The value before the last rotation, kept a week so a line sealed under it still restores; then blank again.
HELD_SEAL_SECRET_PREVIOUS=

# ── Anthropic (Claude) — https://console.anthropic.com/settings/keys ─────────
# The assistant's key; without it Nort, the estimator and the site chat answer that AI is off.
ANTHROPIC_API_KEY=
# Optional: override the default model for every call (lib/anthropic; lib/ai-cost's one override).
ANTHROPIC_MODEL=
# Optional: the model for routine work (lib/ai-cost's "routine" tier) when not the default.
ANTHROPIC_MODEL_ROUTINE=
# Optional: the model for cheap work (lib/ai-cost's "cheap" tier) when not the default.
ANTHROPIC_MODEL_CHEAP=
# Optional: the public site's chat model (api/site-chat) when not the default.
SITE_CHAT_MODEL=
# Monthly AI spend ceiling per company, in dollars (default 150) — an abuse stop, never a usage tier.
AI_MONTHLY_CEILING_USD=

# ── OpenAI — voice fallback (api/tts, api/transcribe) — OPTIONAL ─────────────
# Text-to-speech and speech-to-text when ElevenLabs is not configured.
OPENAI_API_KEY=
# Optional: the TTS model when not the default.
OPENAI_TTS_MODEL=
# Optional: the TTS voice when not the default.
OPENAI_TTS_VOICE=
# Optional: the speech-to-text model when not the default.
OPENAI_STT_MODEL=

# ── ElevenLabs — Nort's voice (api/tts, api/transcribe) — OPTIONAL ───────────
# Neural voice and speech-to-text; blank falls back to OpenAI, then to the browser's own voice.
ELEVENLABS_API_KEY=
# Optional: the voice id when not the default.
ELEVENLABS_VOICE_ID=
# Optional: the TTS model when not the default.
ELEVENLABS_MODEL=
# Optional: the speech-to-text model when not the default.
ELEVENLABS_STT_MODEL=
# Optional: speaking speed (a number) when not the default.
ELEVENLABS_SPEED=

# ── Google — Maps, Places, OAuth (Calendar) ──────────────────────────────────
# Maps JavaScript + Places key, restricted to your domain. Public (used in the browser).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side Places/Geocoding key (lib/google-server); blank falls back to the keys below.
GOOGLE_MAPS_SERVER_KEY=
# Optional server fallback key for Places/Geocoding when no server key is set.
GOOGLE_MAPS_API_KEY=
# Optional: the Referer sent with a browser-restricted key used from the server.
PLACES_PROXY_REFERER=
# Google Calendar sync (lib/google-calendar): OAuth client id and secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: the base URL OAuth callbacks (Google, QuickBooks) return to, when not NEXT_PUBLIC_SITE_URL.
OAUTH_REDIRECT_BASE=

# ── App — hosts, defaults, cron ──────────────────────────────────────────────
# The public base URL of the deployment (auth redirects, links in texts and emails).
# Local dev: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostnames (comma-separated) that serve the APP rather than a company's public site (middleware).
APP_HOSTS=
# The domain companies' public sites hang under (middleware, settings): <slug>.<SITES_DOMAIN>.
SITES_DOMAIN=
# Optional: the public splash domain printed on the business card.
SPLASH_DOMAIN=
# Optional: "1" once North's own site is posted (lib/platform-site).
PLATFORM_SITE_POSTED=
# The default IANA timezone for a company with none set (default America/Los_Angeles).
NEXT_PUBLIC_DEFAULT_TIMEZONE=
# The support address the export doors name when something fails.
SUPPORT_EMAIL=
# Cron secret protecting the timeclock reminder and digest endpoints (Vercel Cron sends it).
CRON_SECRET=
# Optional: the path of a local Chrome for PDF rendering off Vercel (api/pdf).
CHROME_PATH=

# ── Passkeys — Face ID / Touch ID (lib/webauthn) ─────────────────────────────
# The relying-party id (your hostname) and origin; blank derives them from the request.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ── Push — web push (lib/push) and Apple push (lib/apns) ─────────────────────
# VAPID key pair for web push; the public half is used in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: the VAPID subject (a mailto: or URL) when not the default.
VAPID_SUBJECT=
# APNs auth key for the App Store app: key id, team id, the .p8 contents, and the bundle id.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
# Optional: the bundle id when not the default.
APNS_BUNDLE_ID=

# ── Stripe — subscriptions and Stripe Connect — OPTIONAL ─────────────────────
# Leave blank to run without billing (the app skips all subscription gating until these are set).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# The recurring Price ID for the subscription plan (price_...).
STRIPE_PRICE_ID=
# The six tier prices (price_...), read by name from lib/plans priceIdFor(tier, cadence) — STRIPE_PRICE_<TIER>_<CADENCE>, so a repricing is a config change.
# Handyman, monthly then annual (keys-health probes each tier's _MONTHLY).
STRIPE_PRICE_HANDYMAN_MONTHLY=
STRIPE_PRICE_HANDYMAN_ANNUAL=
# Crew, monthly then annual.
STRIPE_PRICE_CREW_MONTHLY=
STRIPE_PRICE_CREW_ANNUAL=
# Company, monthly then annual.
STRIPE_PRICE_COMPANY_MONTHLY=
STRIPE_PRICE_COMPANY_ANNUAL=
# The one-time Extra usage product (price_...); blank hides the Add Usage door; the product's metadata usage_usd is the top-up size (keys-health reads it as optional).
STRIPE_PRICE_EXTRA_USAGE=
# Webhook signing secret from Stripe → Developers → Webhooks (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Webhook signing secret for the Connect (customer payments) endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Billing standing (cn-v1137) — OPTIONAL. Each has a safe default when blank ─
# Company ids (comma-separated) the paywall never blocks — the operator's own house org(s); the column comped_until (Bug Watch › Companies) is the door, this list is the belt.
COMPED_ORG_IDS=
# Days a past-due company keeps access after the period it paid for ends (default 10) — cards fail constantly in the trades; a billing event must never be a work stoppage.
PAST_DUE_GRACE_DAYS=

# ── Twilio — texts (lib/sms) — OPTIONAL ──────────────────────────────────────
# Leave blank to run without texts (reminders log instead of sending). https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
# Either the account's auth token, or an API key pair (preferred).
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The platform's sending number, or a Messaging Service that holds the numbers.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Email — Resend (send quotes/invoices to customers) — OPTIONAL ────────────
# Without these, the "Email to customer" button reports that email isn't set up. https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "Larkspur Electric <quotes@yourdomain.com>".
EMAIL_FROM=

# ── QuickBooks Online (accounting sync) — OPTIONAL ───────────────────────────
# Create an app at https://developer.intuit.com; the redirect URI must be <NEXT_PUBLIC_SITE_URL>/api/quickbooks/callback.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "production" or "sandbox".
QBO_ENVIRONMENT=production

# ── Set by the platform (Vercel, Node, the CI runner) — never typed by hand. Commented out so a copy
# of this file never sets one; listed because the code reads them (the scanner counts a commented name).
# VERCEL_ENV — set by the platform, never by hand: "production", "preview" or "development"; the config alarms only fire in production.
# VERCEL — set by the platform, never by hand: "1" on Vercel, so the PDF route picks the Lambda Chromium.
# AWS_LAMBDA_JS_RUNTIME — set by the platform, never by hand: the PDF route sets it itself on Vercel for the Lambda Chromium build.
# VERCEL_DEPLOYMENT_ID — set by the platform, never by hand: Vercel's deployment id, surfaced as the build id (next.config.ts).
# NODE_ENV — set by the platform, never by hand: Node's own; "development" relaxes the portal cookie's Secure flag.
# CI — set by the platform, never by hand: "true" on the CI runner, where the prod-replay suites skip.

# ── Migrations and the test database (scripts/, the DB suites) — NEVER production values here ─
# The database URL the migration runner connects to (scripts/run-migrations).
DATABASE_URL=
# Alternative name for the same URL (scripts/run-migrations, run-one-migration).
SUPABASE_DB_URL=
# The URL run-one-migration applies a single file against.
MIGRATE_DB_URL=
# The host run-one-migration reads when no URL is given.
PGHOST=
# The TEST database's password, host and user (CI and every integration / db suite).
TEST_DBPW=
TEST_DB_HOST=
TEST_DB_USER=
# The test database's password as scripts/test-db/rebuild reads it.
CN_TEST_DB_PW=
# "1" lets a suite apply its pending migration to the TEST database first.
TEST_APPLY_PENDING=
# "1" lets the shelf suite / the one-place suite apply its migration (a one-off *_APPLY_<n> gate
# or a *_REPLAY toggle is documented at the top of its own suite instead).
SHELF_SUITE_APPLY=
ONE_PLACE_SUITE_APPLY=
# "1" writes the accountant workbook's sample .xlsx to disk during its test.
WRITE_SAMPLE_XLSX=
# The prod-replay suites' read-only connection (never production's writer).
REPLAY_DBPW=
REPLAY_DB_HOST=
REPLAY_DB_USER=
